{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wishlist",
  "routes": [
    { "pattern": "nt.uzskicorp.agency", "custom_domain": true }
  ],
  // Installed workerd supports through 2026-10-19. Advance this when the runtime does.
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "vars": {
    "SEARCH_COUNTRY": "ke",
    "SEARCH_LANGUAGE": "en",
    "DAILY_PROVIDER_CALL_LIMIT": "40"
  },
  // Names only. Values live in .dev.vars locally and Wrangler secrets in production.
  "secrets": {
    "required": [
      "SENTRY_DSN",
      "SERPER_API_KEY",
      "BETTER_AUTH_SECRET",
      "BETTER_AUTH_URL",
      "GOOGLE_CLIENT_ID",
      "GOOGLE_CLIENT_SECRET",
      "RESEND_API_KEY",
      "RESEND_FROM"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wishlist",
      "database_id": "e6281ba4-35ec-410b-9e9d-d4b40048dadd",
      "preview_database_id": "wishlist-local",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "wishlist-images"
    }
  ]
}
