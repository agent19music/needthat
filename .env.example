# Absolute origin for canonical and social URLs.
# Leave unset to use the host that served the request.
# Production build: VITE_SITE_URL=https://nt.uzskicorp.agency

# Client-visible Sentry DSN. The same value belongs in .dev.vars as SENTRY_DSN
# so the Worker runtime can report server errors. Leave blank to disable Sentry.
VITE_SENTRY_DSN=

# Source-map upload only. Not a Worker binding.
VITE_SENTRY_ORG=
VITE_SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Copy the Worker secrets below into .dev.vars. Do not commit that file.
# SENTRY_DSN=
# SERPER_API_KEY=
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=http://localhost:3000
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Password reset and email changes. Leave blank to skip sending mail.
# RESEND_API_KEY=
# RESEND_FROM=Needthat <hello@nt.uzskicorp.agency>

# Non-secret Worker vars are set in wrangler.jsonc:
# SEARCH_COUNTRY, SEARCH_LANGUAGE, DAILY_PROVIDER_CALL_LIMIT
